# Backup current .gitignore (just in case)
Copy-Item .gitignore .gitignore.backup

# Create comprehensive .gitignore
@"
# ==============================================================================
# Build Artifacts
# ==============================================================================
build/
**/build/
/build*/
*.hex
*.bin
*.elf
*.map
*.lst
*.o
*.obj
*.a
*.lib

# Merged firmware outputs
merged.hex
merged.bin
app_update.bin

# CMake build files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Build logs
build_log.txt
*.log

# ==============================================================================
# nRF Connect SDK / Zephyr
# ==============================================================================
.west/
.config
.config.old
.cache/
zephyr/.config
zephyr/CMakeCache.txt
*.dts.pre.tmp
*.dts_compiled

# ==============================================================================
# IDE and Editor Files
# ==============================================================================

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.history/

# IntelliJ / CLion
.idea/
*.iml
*.iws
*.ipr
cmake-build-*/

# Editors
*.swp
*.swo
*~
.*.sw?

# ==============================================================================
# Operating System Files
# ==============================================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
`$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
.Trash-*

# ==============================================================================
# Certificates and Secrets
# ==============================================================================
*.pem
*.key
*.crt
*.cer
!*_template.*
!*_example.*
secrets.h
secrets.conf
.env
.env.local

# ==============================================================================
# Logs and Debug Output
# ==============================================================================
*.log
logs/
debug/
*.rtt
*.jlink

# ==============================================================================
# Keep These Files
# ==============================================================================
!README.md
!prj.conf
!CMakeLists.txt
!Kconfig
"@ | Out-File -FilePath .gitignore -Encoding utf8 -NoNewline

Write-Host "✅ .gitignore updated!" -ForegroundColor Green